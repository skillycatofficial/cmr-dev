# ─── Sanity CMS ──────────────────────────────────────────────────────────────
# Get these from https://www.sanity.io/manage → your project → Settings → API

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: for server-side mutations / webhooks (never expose to browser)
# SANITY_API_TOKEN=your_token_here

# ─── reCAPTCHA v3 (spam protection on Contact/Enquiry/Careers forms) ─────────
# Get these from https://www.google.com/recaptcha/admin — register the site
# domain, choose reCAPTCHA v3. Forms work without these set; spam checking
# only activates once both are present.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here
